SECRET_KEY=dev-only-secret
DEBUG=1
HOST=127.0.0.1
PORT=8000

GUARDIAN_API_KEY=your_guardian_api_key_here #Replace With Your Guardian Open Platform API key
NEWSAPI_KEY=your_newsapi_key_here #Replace With Your NewsAPI.org API key
SERPAPI_KEY=your_serpapi_key_here #Replace With SerpAPI key for search engine results

GOOGLE_TRENDS_GEO=AU # Default geographic region for Google Trends (AU = Australia)
GOOGLE_TRENDS_TZ=-660 # Timezone offset for Google Trends (e.g. -660 for AEST)

REDDIT_CLIENT_ID=your_reddit_client_id_here # Reddit app client ID
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here # Reddit app client secret
REDDIT_USER_AGENT=AI Bot Listening by /u/your_reddit_username_here # User agent string for Reddit API requests

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority # Replace <username>, <password>, and <cluster> with real values
MONGODB_DBNAME=pace_database