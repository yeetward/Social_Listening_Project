# =============================================================================
# Pace-Unit AI Configuration
# =============================================================================
# This file contains all credentials and configuration for the AI backend.
# For handover: Update these values with your own credentials.
# =============================================================================

# MongoDB Configuration
# Replace with your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Groq API Configuration
# Replace with your Groq API key from https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here
